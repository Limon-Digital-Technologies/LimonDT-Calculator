{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limon Calculator",
  "version": "1.1.0",
  "identifier": "tech.limon.digital.calculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Limon Calculator",
        "width": 1180,
        "height": 820,
        "minWidth": 640,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
